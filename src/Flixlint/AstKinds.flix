        case 27 => Some(Attr.IsConstructor)
        case 28 => Some(Attr.IsInterface)
        case 29 => Some(Attr.IsOpen)
        case 30 => Some(Attr.IsRuntimeVisible)
        case 31 => Some(Attr.IsVarArgs)
        case 32 => Some(Attr.Itpe)
        case 33 => Some(Attr.Label)
        case 34 => Some(Attr.M)
        case 35 => Some(Attr.MethodName)
        case 36 => Some(Attr.Mod)
        case 37 => Some(Attr.Mode)
        case 38 => Some(Attr.Modifiers)
        case 39 => Some(Attr.Name)
        case 40 => Some(Attr.Op)
        case 41 => Some(Attr.OptPreds)
        case 42 => Some(Attr.Owner)
        case 43 => Some(Attr.ParameterNames)
        case 44 => Some(Attr.Polarity)
        case 45 => Some(Attr.Pos)
        case 46 => Some(Attr.Pred)
        case 47 => Some(Attr.RegSym)
        case 48 => Some(Attr.RetTpe)
        case 49 => Some(Attr.RunEff)
        case 50 => Some(Attr.Sop)
        case 51 => Some(Attr.Src)
        case 52 => Some(Attr.Star)
        case 53 => Some(Attr.Sym)
        case 54 => Some(Attr.SymUse)
        case 55 => Some(Attr.Syms)
        case 56 => Some(Attr.Targ)
        case 57 => Some(Attr.Targs)
        case 58 => Some(Attr.Tpe)
        case 59 => Some(Attr.Tpe1)
        case 60 => Some(Attr.Tpe2)
        case 61 => Some(Attr.Tpes)
        case 62 => Some(Attr.Withh)
        case _ => None
    }

    /// Every `Attr`, in number order.
    pub def attrs(): Vector[Attr] = Vector#{Attr.Elem_1, Attr.Alias, Attr.AllowSubeffecting, Attr.Arg, Attr.Arity, Attr.ArrowTpe, Attr.AsEff, Attr.BodyEff, Attr.BodyType, Attr.Cast, Attr.Clazz, Attr.Cst, Attr.Cst_lit, Attr.DeclaredEff, Attr.DeclaredType, Attr.Decreasing, Attr.Den, Attr.Desc, Attr.Descriptor, Attr.Eff, Attr.Erasure, Attr.ExpectedEff, Attr.ExpectedType, Attr.FieldName, Attr.Fixity, Attr.HandledEff, Attr.Ident, Attr.IsConstructor, Attr.IsInterface, Attr.IsOpen, Attr.IsRuntimeVisible, Attr.IsVarArgs, Attr.Itpe, Attr.Label, Attr.M, Attr.MethodName, Attr.Mod, Attr.Mode, Attr.Modifiers, Attr.Name, Attr.Op, Attr.OptPreds, Attr.Owner, Attr.ParameterNames, Attr.Polarity, Attr.Pos, Attr.Pred, Attr.RegSym, Attr.RetTpe, Attr.RunEff, Attr.Sop, Attr.Src, Attr.Star, Attr.Sym, Attr.SymUse, Attr.Syms, Attr.Targ, Attr.Targs, Attr.Tpe, Attr.Tpe1, Attr.Tpe2, Attr.Tpes, Attr.Withh}
}
