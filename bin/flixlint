#!/usr/bin/env bash
# flixlint: architecture rules for Flix, checked on the compiler's AST.
#
#   flixlint [--flix-jar JAR] --rules PATH/rules.flix [--pkg FPKG]... [--jar JAR]... [--stage typed|resolved]
#            [--today YYYY-MM-DD] [--limits FILE.json|DIR [--limits-base FILE.json|DIR] [--held]] [--facts-out DIR] [--build-dir DIR] [--project-root DIR] [--offline] [--shim JAR]
#            [--java-opts "..."] [--spans FILE] [--resident [--heap-mb N] [--idle-minutes N] [--run-limit SECONDS]] [--timeout SECONDS] SRC...
#   flixlint --resident-stop [--flix-jar JAR] [--shim JAR]
#   flixlint --check [--version-file FILE] [--flix-jar JAR] [--shim JAR] [--heap-mb N] [--idle-minutes N] [--run-limit SECONDS] [--timeout SECONDS]
#   flixlint --test [--build-dir DIR] [--flix-jar JAR] [--shim JAR] [--heap-mb N] [--idle-minutes N] [--run-limit SECONDS] [--timeout SECONDS]
#   flixlint [--flix-jar JAR] --spans FILE [--stage typed|resolved] [--pkg FPKG]... [--jar JAR]... [--project-root DIR] [--offline] SRC...
#   flixlint --socket-name ROOT IDENTITY
#   flixlint --version
#
# --spans FILE also writes the position of every name (README "Spans"); without --rules only that index is written.
# --limits: a ratchet at its limit holds its violations; one line on stderr counts them and <build-dir>/held.txt has them
# all (--held lists them on stdout too).
#
# Exit codes: 0 no violation, 1 violations (or a ratchet off its limit), 2 the rules are wrong (rules.flix does not compile, an allow that matches
#             nothing, an allowInFile of a file that is not among the sources, a limit for no rule), 3 the sources do not compile,
#             4 the call or the environment is wrong (a missing option, no flix.jar, no scala-cli, a missing package).
#
# Steps: 1) the shim (Scala, on the compiler jar) walks the AST and writes the facts as TSV plus Names.flix
#        2) the rule engine (Flix: the Flixlint library + Names.flix + rules.flix + a generated main) is built into a
#           jar, once per distinct set of those sources, and run against the facts: in the shim's JVM when the jar
#           is already built (flixlint.Lint), in a JVM of its own right after a rebuild.
#
# Environment: FLIX_JAR (the compiler), FLIXLINT_SHIM (a prebuilt shim jar), FLIXLINT_JAVA_OPTS,
#              FLIXLINT_RESIDENT=1 (as --resident), FLIXLINT_RESIDENT_IDLE (as --idle-minutes; 30),
#              FLIXLINT_TIMING=1 (the rule engine prints how long loading, judging and each custom rule took, on stderr).
#              FLIXLINT_HELD=1 (as --held: the violations a ratchet holds within its limit are listed too).
#              FLIXLINT_DUMP_REL=DIR (the rule engine writes the relations it builds from the generic AST into DIR as the old
#              facts' TSV files, to compare them table by table: test/compare-old.sh).
#
# --resident keeps one JVM per project root (the current directory) and identity (the compiler jar and the shim jar)
# with the compiler and the rule engines loaded (shim/Resident.scala): after the first run only the files that changed
# are compiled again, whatever the build directory, the stage, or whether it is a lint or the index. A run without
# --resident uses that server when one is up, and runs on its own when none is. --resident-stop stops it. The budget
# (--heap-mb, --idle-minutes, --run-limit) is the caller's and is read when the server starts.
#
# WhyNot: the rule engine is not run through `flix run` on loose files every time. Compiling it costs seconds, so the
# jar is keyed by the hash of its sources and rebuilt only when the rules change, or a name they write comes or goes
# (Names.flix has a case only for the names the rule file writes; the rest are read from the facts, names.tsv).
set -eu

# WhyNot: `dirname "$0"` だけで済ませない。flixlint は submodule や release の展開先から PATH の symlink で
# 呼ばれる事があり、その時 $0 の親は symlink の置き場になって rules/ も shim/ も見つからない。
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
here="$(cd "$(dirname "$self")/.." && pwd)"

version="$(sed -n 's/^version *= *"\(.*\)"/\1/p' "$here/flix.toml")"

flix_jar="${FLIX_JAR:-}"
rules=""
project_root=""
offline=()
pkgs=()
jars=()
stage="typed"
today=""
limits=""
limits_base=""
facts_out=""
spans=""
build_dir="build/flixlint"
shim="${FLIXLINT_SHIM:-}"
java_opts="${FLIXLINT_JAVA_OPTS:--Xss32m -XX:MaxRAMPercentage=35}"
resident="${FLIXLINT_RESIDENT:-0}"
resident_stop=0
check=0
test_mode=0
version_file=""
heap_mb=""
idle_minutes="${FLIXLINT_RESIDENT_IDLE:-30}"
run_limit=900
timeout=""
timing="${FLIXLINT_TIMING:-}"
dump_rel="${FLIXLINT_DUMP_REL:-}"
held="${FLIXLINT_HELD:-}"
srcs=()
setting_opts=()

# WhyNot: 使い方の断りに 1 も 2 も使わない。1 は「違反が在る」、2 は「規則が間違っている」で、CI からは
# どちらも lint が仕事をした結果に見える。呼び方と環境の誤りは 4 で分ける。
usage() { sed -n '2,/^# Exit codes/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }
die() { echo "flixlint: $1" >&2; exit 4; }

# ---- where a resident server listens (README "Resident server": the same formula in every client) ----
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -c1-64; }
# The first 16 hex digits of the SHA-256 of the root, a newline, and the identity.
socket_name() { printf '%s\n%s' "$1" "$2" | sha256 | cut -c1-16; }
# The user's cache: ~/Library/Caches on macOS, %LOCALAPPDATA% on Windows, $XDG_CACHE_HOME or ~/.cache elsewhere.
cache_dir() {
    case "$(uname -s)" in
        Darwin) echo "$HOME/Library/Caches/flixlint" ;;
        MINGW*|MSYS*|CYGWIN*) echo "${LOCALAPPDATA:-$HOME/AppData/Local}/flixlint" ;;
        *) echo "${XDG_CACHE_HOME:-$HOME/.cache}/flixlint" ;;
    esac
}

while [ $# -gt 0 ]; do
    case "$1" in
        --flix-jar) flix_jar="$2"; shift 2 ;;
        --rules) rules="$2"; shift 2 ;;
        --pkg) pkgs+=(--pkg "$2"); shift 2 ;;
        --jar) jars+=(--jar "$2"); shift 2 ;;
        --stage) stage="$2"; shift 2 ;;
        --today) today="$2"; shift 2 ;;
        --limits) limits="$2"; shift 2 ;;
        --limits-base) limits_base="$2"; shift 2 ;;
        --held) held=1; shift ;;
        --facts-out) facts_out="$2"; shift 2 ;;
        --spans) spans="$2"; shift 2 ;;
        --build-dir) build_dir="$2"; shift 2 ;;
        --shim) shim="$2"; shift 2 ;;
        --java-opts) java_opts="$2"; shift 2 ;;
        --project-root) project_root="$2"; shift 2 ;;
        --offline) offline=(--offline); shift ;;
        --resident) resident=1; shift ;;
        --resident-stop) resident_stop=1; shift ;;
        --check) check=1; shift ;;
        --test) test_mode=1; shift ;;
        --version-file) version_file="$2"; shift 2 ;;
        --heap-mb) heap_mb="$2"; shift 2 ;;
        --idle-minutes) idle_minutes="$2"; shift 2 ;;
        --run-limit) run_limit="$2"; shift 2 ;;
        --timeout) timeout="$2"; shift 2 ;;
        --socket-name) [ $# -ge 3 ] || die "--socket-name ROOT IDENTITY"; socket_name "$2" "$3"; exit 0 ;;
        --version) echo "flixlint $version"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        --*) echo "flixlint: unknown option $1" >&2; usage >&2; exit 4 ;;
        *) srcs+=("$1"); shift ;;
    esac
done
# 何も指さなかった時だけ bin/flix-jar の解決に落ちる（FLIX_JAR か --flix-jar が在ればそちらが勝つ）。
if [ -z "$flix_jar" ] && [ -x "$here/bin/flix-jar" ]; then flix_jar="$("$here/bin/flix-jar" || true)"; fi
[ -n "$flix_jar" ] && [ -f "$flix_jar" ] || die "--flix-jar JAR (or FLIX_JAR) must point at flix.jar"
[ "$resident_stop" = 1 ] || [ "$check" = 1 ] || [ "$test_mode" = 1 ] || [ -n "$rules" ] || [ -n "$spans" ] || die "--rules PATH/rules.flix is required (or --spans FILE for the index alone)"
[ -z "$rules" ] || [ -f "$rules" ] || die "rules file not found: $rules"
[ "$resident_stop" = 1 ] || [ "$check" = 1 ] || [ "$test_mode" = 1 ] || [ ${#srcs[@]} -gt 0 ] || die "at least one source directory is required"
case "$stage" in typed|resolved) ;; *) die "unknown --stage $stage (typed or resolved)" ;; esac
[ -n "$today" ] || today="$(date +%Y-%m-%d)"
if [ -n "$limits" ] && [ ! -e "$limits" ]; then die "limits file or directory not found: $limits"; fi
if [ -n "$limits_base" ] && [ -z "$limits" ]; then die "--limits-base needs --limits"; fi
if [ -n "$limits_base" ] && [ ! -e "$limits_base" ]; then die "limits base file or directory not found: $limits_base"; fi
for n in "$heap_mb" "$idle_minutes" "$run_limit" "$timeout"; do
    case "$n" in ''|*[!0-9]*) [ -z "$n" ] || die "--heap-mb, --idle-minutes, --run-limit and --timeout take a whole number ($n)" ;; esac
done
[ -n "$facts_out" ] || facts_out="$build_dir/facts"
[ "$resident_stop" = 1 ] || [ "$check" = 1 ] || mkdir -p "$build_dir"

# ---- the dependencies, when the caller passed none ----
# WhyNot: flix.toml is not read here. It is TOML, the short and the table form of a dependency both have to be
# understood, and the closure over the installed packages' own manifests with it; the compiler jar the shim already
# runs on carries ManifestParser, so the shim reads it there, typed.
root_opt=()
[ -n "$project_root" ] && root_opt=(--project-root "$project_root")

# The module of rules.flix that holds `pub def rules(): Flixlint.RuleSet`: its first `mod` declaration.
if [ -n "$rules" ]; then
    rules_mod="$(grep -m1 -oE '^[[:space:]]*(pub[[:space:]]+)?mod[[:space:]]+[A-Za-z0-9_.]+' "$rules" | awk '{print $NF}')"
    [ -n "$rules_mod" ] || die "$rules must declare a module (mod MyRules { pub def rules(): Flixlint.RuleSet = ... })"
fi

# ---- 1. the shim (built once, or taken prebuilt from --shim / FLIXLINT_SHIM) ----
# WhyNot: the built shim does not go under $build_dir by default. It only depends on shim/*.scala and the compiler
# jar, not on the project being linted, so one copy next to the sources serves every project on the machine.
if [ -n "$shim" ]; then
    [ -f "$shim" ] || die "shim jar not found: $shim"
else
    shim="$here/build/flixlint-shim.jar"
    if [ ! -f "$shim" ] || [ -n "$(find "$here/shim" -newer "$shim" -name '*.scala')" ]; then
        # WhyNot: devbox を必ず挟まない。flixlint を release の tarball で置いた所には devbox.json ごと在るとは
        # 限らず、PATH に scala-cli が在れば devbox は要らない。
        if [ -f "$here/devbox.json" ] && command -v devbox >/dev/null 2>&1; then
            scala_cli=(devbox run -- scala-cli)
        elif command -v scala-cli >/dev/null 2>&1; then
            scala_cli=(scala-cli)
        else
            echo "flixlint: the shim is not built and scala-cli was not found." >&2
            echo "          install scala-cli (flixlint's devbox.json has it), or pass a prebuilt jar with" >&2
            echo "          --shim JAR / FLIXLINT_SHIM=JAR (the release has flixlint-shim-<flix version>.jar)." >&2
            exit 4
        fi
        mkdir -p "$here/build"
        echo "flixlint: building the shim" >&2
        (cd "$here" && "${scala_cli[@]}" --power package shim --jar "$flix_jar" --library -o "$shim" -f >/dev/null) \
            || die "the shim did not build (scala-cli package shim)"
    fi
fi

# ---- the resident server (--resident, shim/Resident.scala) ----
# The compiler jar by path, size and mtime (the key of engine.jar below).
# WhyNot: not the BSD spelling first. GNU `stat -f` means "the file system's status" and prints the free blocks, which
# change from run to run, so on a Mac with coreutils on PATH the key never matched and the engine was rebuilt every
# run; BSD `stat -c` is an illegal option that prints nothing, so the GNU spelling is tried first.
mtime_of() { stat -c %Y -- "$1" 2>/dev/null || stat -f %m -- "$1" 2>/dev/null || echo unknown; }
jar_id="$flix_jar $(wc -c < "$flix_jar") $(mtime_of "$flix_jar")"
cache="$(cache_dir)"
# The SHA-256 of a file's bytes, kept in the cache under its path, size and mtime (a compiler jar is tens of MB).
content_hash() {
    local kept h
    kept="$cache/hash/$(printf '%s' "$1 $(wc -c < "$1") $(mtime_of "$1")" | sha256 | cut -c1-32)"
    if [ -f "$kept" ]; then read -r h < "$kept"; else
        h="$(sha256 < "$1")"
        mkdir -p "$cache/hash" && printf '%s\n' "$h" > "$kept.$$" && mv "$kept.$$" "$kept"
    fi
    printf '%s' "$h"
}
# One server per project root and identity. The root is the current directory: the facts' and the violations' paths
# are relative to it, and the server runs there. The identity is the bytes of the compiler and of the shim, so a
# rebuilt shim or another compiler gets a server of its own and never runs with the old code; the build directory and
# the stage are each run's own arguments, so a lint at both stages and the index share the one compiler.
# WhyNot: the socket is not put under $build_dir or the project. A Unix socket's path is capped near 100 bytes, and the
# user's cache is a short path only this user writes to.
root="$(pwd -P)"
identity="flix=$(content_hash "$flix_jar") shim=$(content_hash "$shim")"
socket="$cache/$(socket_name "$root" "$identity").sock"
server_log="${socket%.sock}.log"
# WhyNot: no resident server where the socket's path would be cut (a long $HOME): a run on its own is slower, not wrong.
[ ${#socket} -le 100 ] || { resident=0; socket=/nonexistent; }
# The client is a JVM that only relays bytes, so it skips the optimizing compiler and the parallel collector.
resident_client() {
    local kind="$1"; shift
    java -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -cp "$flix_jar:$shim" flixlint.Resident client --socket "$socket" \
        --root "$root" --identity "$identity" --kind "$kind" ${timeout:+--timeout "$timeout"} ${setting_opts[@]+"${setting_opts[@]}"} "$@"
}
start_server() {
    local opts="$java_opts"
    # -Xmx wins over the default's -XX:MaxRAMPercentage.
    [ -z "$heap_mb" ] || opts="$opts -Xmx${heap_mb}m"
    mkdir -p "$cache"
    echo "flixlint: starting the resident server (log: $server_log)" >&2
    # shellcheck disable=SC2086
    java $opts -cp "$flix_jar:$shim" flixlint.Resident server --socket "$socket" --root "$root" --identity "$identity" \
        --idle-minutes "$idle_minutes" --run-limit "$run_limit" </dev/null >>"$server_log" 2>&1 &
}
if [ "$resident_stop" = 1 ]; then
    if [ -S "$socket" ]; then resident_client stop >/dev/null 2>&1 || true; fi
    exit 0
fi

engine="$build_dir/engine"
[ "$check" = 1 ] || { rm -rf "$engine/src"; mkdir -p "$engine/src/Flixlint"; }
spans_opt=()
[ -n "$spans" ] && spans_opt=(--spans "$spans")
names_of=()
[ -n "$rules" ] && names_of=(--names-of "$rules")
facts_args=(--out "$facts_out" --names-out "$engine/src/Flixlint/Names.flix" "${names_of[@]}" --stage "$stage" "${spans_opt[@]}" "${root_opt[@]}" "${offline[@]}" "${pkgs[@]}" "${jars[@]}" "${srcs[@]}")

# Says why the facts could not be written, and leaves with the shim's exit code.
facts_failed() {
    # WhyNot: the compiler's Resolution Error does not say that a dependency is missing, and sources that
    # `flix check` accepts fail here when the packages are not passed, so exit 3 with no --pkg says it.
    if [ "$1" -eq 3 ] && [ ${#pkgs[@]} -eq 0 ]; then
        echo "flixlint: the sources do not compile. If they depend on packages that flixlint did not find, name the" >&2
        echo "          project with --project-root DIR, or pass them with --pkg lib/github/.../x.fpkg --jar" >&2
        echo "          lib/cache/.../y.jar (the compiler unpacks them into lib/ once 'flix check' has run)." >&2
    fi
    exit "$1"
}

# The resident server when one is up (or --resident starts it); exit 11 when no server served the run.
# $1 is the kind (lint: the facts and the engine; spans: the facts alone, the index), the rest what to run.
# A live server is always queued for (README "Resident server": a busy server says so, and the run waits its turn).
# One that went away during the run (exit 12) is started once more and the run sent again; when that one goes away
# too, a lint runs on its own and the index stops (two JVMs of a typed compiler do not fit beside each other).
via_resident() {
    status=11
    if [ -S "$socket" ]; then resident_client "$@"; status=$?; fi
    if [ "$status" -eq 12 ]; then
        echo "flixlint: the resident server stopped during the run; starting it again" >&2
    fi
    if { [ "$status" -eq 11 ] && [ "$resident" = 1 ]; } || [ "$status" -eq 12 ]; then
        start_server
        local kind="$1"; shift
        resident_client "$kind" --wait 60 "$@"
        status=$?
        if [ "$status" -eq 12 ]; then
            echo "flixlint: the resident server stopped during the run again (log: $server_log)" >&2
            [ "$kind" = lint ] && status=11 || status=4
        fi
    fi
    if [ "$status" -eq 13 ]; then status=4; fi
}

# --check: `flix check` of the project in the current directory on the resident server (started when none is up), which
# shares its compiler with the lints; the version of the sources it checked goes into --version-file
# (checkd-freshness §3). With no server to serve it, `flix check` in a JVM of its own (no version is written then).
if [ "$check" = 1 ]; then
    resident=1
    [ -z "$version_file" ] || rm -f "$version_file"
    set +e
    via_resident check ${version_file:+--version-file "$version_file"}
    if [ "$status" -eq 11 ]; then
        # shellcheck disable=SC2086
        java $java_opts -jar "$flix_jar" check
        status=$?
    fi
    exit "$status"
fi

# --test: `flix test` of the project in the current directory. The resident server compiles the tests (test-jar: the
# classes and the list of tests under the build directory, named after the version of the sources) and they run in a
# JVM of their own (flixlint.TestRun), so a test that loops or exits never takes the server down (checkd-freshness
# §4.3). With no server to serve it, `flix test` in a JVM of its own.
if [ "$test_mode" = 1 ]; then
    resident=1
    out="$build_dir/test"; mkdir -p "$out"; rm -f "$out/version"
    set +e
    via_resident test-jar --version-file "$out/version" "$out"
    if [ "$status" -eq 11 ]; then
        # shellcheck disable=SC2086
        java $java_opts -Djava.awt.headless=true -jar "$flix_jar" test
        exit $?
    fi
    [ "$status" -eq 0 ] && [ -s "$out/version" ] || exit "$status"
    # shellcheck disable=SC2086
    java $java_opts -Djava.awt.headless=true -cp "$flix_jar:$shim" flixlint.TestRun "$out/test-$(cat "$out/version").tests"
    exit $?
fi

# --spans without --rules: the index is what was asked for, and the rule engine has nothing to run. The resident
# server serves it too (a tool that looks names up runs it again after every edit, and the warm compiler is the point).
if [ -z "$rules" ]; then
    set +e
    via_resident spans "${facts_args[@]}"
    if [ "$status" -eq 11 ]; then
        # shellcheck disable=SC2086
        java $java_opts -cp "$flix_jar:$shim" flixlint.Facts "${facts_args[@]}"
        status=$?
    fi
    set -e
    [ "$status" -eq 0 ] || facts_failed "$status"
    exit 0
fi

# ---- 2. the engine: library + Names.flix (written by the shim) + rules.flix + main ----
cp "$here"/src/Flixlint/*.flix "$engine/src/Flixlint/"
cp "$here"/src/Flixlint.flix "$engine/src/"
cp "$rules" "$engine/src/Rules.flix"
printf 'def main(): Unit \\ IO = Flixlint.Engine.lint(%s.rules())\n' "$rules_mod" > "$engine/src/Main.flix"

# The key of engine.jar: the compiler and every engine source but Names.flix, which the shim adds to it once written.
# WhyNot: the compiler jar is not left out of the key. It is what builds engine.jar, so another FLIX_JAR with the
# same rule sources would reuse the jar the first compiler built. Path, size and mtime identify it without hashing a
# hundred megabytes on every run (an mtime it cannot read only makes the key coarser). LC_ALL=C fixes the order the
# globs expand in, which is the collation order and so the locale's.
key="$(export LC_ALL=C; { echo "$jar_id"; cat "$engine"/src/*.flix "$engine"/src/Flixlint/*.flix; } | shasum | cut -c1-40)"
engine_jar="$engine/artifact/engine.jar"
# The engine's settings (Flixlint.Engine.settingsOf), one list for every way the engine runs: the environment of a JVM
# of its own (flixlint.Lint, engine.jar), and `--setting` of the request to the resident server.
# WhyNot: the resident client does not read them from its environment. The server's engine never sees the caller's
# environment, so a setting the client did not know by name was lost there alone (FLIXLINT_TIMING in 0.7.1).
settings=("FLIXLINT_FACTS=$facts_out" "FLIXLINT_TODAY=$today" "FLIXLINT_LIMITS=$limits" "FLIXLINT_LIMITS_BASE=$limits_base" "FLIXLINT_TIMING=$timing" "FLIXLINT_DUMP_REL=$dump_rel" "FLIXLINT_HELD=$held")
export "${settings[@]}"
for s in "${settings[@]}"; do setting_opts+=(--setting "$s"); done

# The facts, then the engine in the same JVM when engine.jar was built for these sources (flixlint.Lint).
# WhyNot: not one JVM for the facts and another for the engine. Each start costs the JVM and the class loading of
# the Flix runtime, on every run; only a rebuild of the engine (exit 10) still takes a JVM of its own.
rm -f "$engine/wanted-hash"
lint_args=(--engine "$engine" --engine-key "$key" "${facts_args[@]}")
# The resident server when one is up (or --resident starts it), else a JVM of its own.
set +e
via_resident lint "${lint_args[@]}"
if [ "$status" -eq 11 ]; then
    # shellcheck disable=SC2086
    java $java_opts -cp "$flix_jar:$shim" flixlint.Lint "${lint_args[@]}"
    status=$?
fi
set -e
case "$status" in
    10) ;;
    3|4) facts_failed "$status" ;;
    *) exit "$status" ;;
esac

printf '[package]\nversion = "0.0.0"\nflix = "0.0.0"\n' > "$engine/flix.toml"
rm -f "$engine/built-hash"
# shellcheck disable=SC2086
if ! (cd "$engine" && java $java_opts -jar "$flix_jar" build-jar --no-install >build.log 2>&1); then
    echo "flixlint: the rules do not compile ($rules; the names come from $engine/src/Flixlint/Names.flix):" >&2
    # The engine compiles the rule file as src/Rules.flix, so the compiler's paths are rewritten back to --rules.
    # WhyNot: not the last 60 lines. Flix reports the errors in order and the later ones usually follow from the
    # first, so the end of the log is the derived noise and the head is the one error worth reading.
    tr '\r' '\n' < "$engine/build.log" | grep -a -vE '^[[:space:]]*$|^[[:space:]]*\[|^(Found|Resolving|Downloading|  Running|Dependency resolution)' | sed "s@src/Rules\.flix@$rules@g" | head -60 >&2
    echo "flixlint: the whole compiler output is in $engine/build.log" >&2
    exit 2
fi
cp "$engine/wanted-hash" "$engine/built-hash"
# shellcheck disable=SC2086
java $java_opts -jar "$engine_jar"
