#!/usr/bin/env bash
# flixlint: architecture rules for Flix, checked on the compiler's AST.
#
#   flixlint [--flix-jar JAR] --rules PATH/rules.flix [--pkg FPKG]... [--jar JAR]... [--stage typed|resolved]
#            [--today YYYY-MM-DD] [--facts-out DIR] [--build-dir DIR] [--project-root DIR] [--shim JAR]
#            [--java-opts "..."] SRC...
#   flixlint --version
#
# Exit codes: 0 no violation, 1 violations, 2 the rules are wrong (rules.flix does not compile, an allow that matches
#             nothing, an allowInFile of a file that is not among the sources), 3 the sources do not compile,
#             4 the call or the environment is wrong (a missing option, no flix.jar, no scala-cli, a missing package).
#
# Steps: 1) the shim (Scala, on the compiler jar) walks the AST and writes the facts as TSV plus Names.flix
#        2) the rule engine (Flix: the Flixlint library + Names.flix + rules.flix + a generated main) is built into a
#           jar, once per distinct set of those sources, and run against the facts.
#
# Environment: FLIX_JAR (the compiler), FLIXLINT_SHIM (a prebuilt shim jar), FLIXLINT_JAVA_OPTS.
#
# WhyNot: the rule engine is not run through `flix run` on loose files every time. Compiling it costs seconds, so the
# jar is keyed by the hash of its sources and rebuilt only when the rules or the names change.
set -eu

# WhyNot: `dirname "$0"` だけで済ませない。flixlint は submodule や release の展開先から PATH の symlink で
# 呼ばれる事があり、その時 $0 の親は symlink の置き場になって rules/ も shim/ も見つからない。
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
here="$(cd "$(dirname "$self")/.." && pwd)"

version="$(sed -n 's/^version *= *"\(.*\)"/\1/p' "$here/flix.toml")"

flix_jar="${FLIX_JAR:-}"
rules=""
project_root=""
pkgs=()
jars=()
stage="typed"
today=""
facts_out=""
build_dir="build/flixlint"
shim="${FLIXLINT_SHIM:-}"
java_opts="${FLIXLINT_JAVA_OPTS:--Xss32m -XX:MaxRAMPercentage=35}"
srcs=()

# WhyNot: 使い方の断りに 1 も 2 も使わない。1 は「違反が在る」、2 は「規則が間違っている」で、CI からは
# どちらも lint が仕事をした結果に見える。呼び方と環境の誤りは 4 で分ける。
usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; }
die() { echo "flixlint: $1" >&2; exit 4; }

while [ $# -gt 0 ]; do
    case "$1" in
        --flix-jar) flix_jar="$2"; shift 2 ;;
        --rules) rules="$2"; shift 2 ;;
        --pkg) pkgs+=(--pkg "$2"); shift 2 ;;
        --jar) jars+=(--jar "$2"); shift 2 ;;
        --stage) stage="$2"; shift 2 ;;
        --today) today="$2"; shift 2 ;;
        --facts-out) facts_out="$2"; shift 2 ;;
        --build-dir) build_dir="$2"; shift 2 ;;
        --shim) shim="$2"; shift 2 ;;
        --java-opts) java_opts="$2"; shift 2 ;;
        --project-root) project_root="$2"; shift 2 ;;
        --version) echo "flixlint $version"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        --*) echo "flixlint: unknown option $1" >&2; usage >&2; exit 4 ;;
        *) srcs+=("$1"); shift ;;
    esac
done
# 何も指さなかった時だけ bin/flix-jar の解決に落ちる（FLIX_JAR か --flix-jar が在ればそちらが勝つ）。
if [ -z "$flix_jar" ] && [ -x "$here/bin/flix-jar" ]; then flix_jar="$("$here/bin/flix-jar" || true)"; fi
[ -n "$flix_jar" ] && [ -f "$flix_jar" ] || die "--flix-jar JAR (or FLIX_JAR) must point at flix.jar"
[ -n "$rules" ] || die "--rules PATH/rules.flix is required"
[ -f "$rules" ] || die "rules file not found: $rules"
[ ${#srcs[@]} -gt 0 ] || die "at least one source directory is required"
case "$stage" in typed|resolved) ;; *) die "unknown --stage $stage (typed or resolved)" ;; esac
[ -n "$today" ] || today="$(date +%Y-%m-%d)"
[ -n "$facts_out" ] || facts_out="$build_dir/facts"
mkdir -p "$build_dir"

# ---- the dependencies, when the caller passed none ----
# WhyNot: flix.toml is not read here. It is TOML, the short and the table form of a dependency both have to be
# understood, and the closure over the installed packages' own manifests with it; the compiler jar the shim already
# runs on carries ManifestParser, so the shim reads it there, typed.
root_opt=()
[ -n "$project_root" ] && root_opt=(--project-root "$project_root")

# The module of rules.flix that holds `pub def rules(): Flixlint.RuleSet`: its first `mod` declaration.
rules_mod="$(grep -m1 -oE '^[[:space:]]*(pub[[:space:]]+)?mod[[:space:]]+[A-Za-z0-9_.]+' "$rules" | awk '{print $NF}')"
[ -n "$rules_mod" ] || die "$rules must declare a module (mod MyRules { pub def rules(): Flixlint.RuleSet = ... })"

# ---- 1. the shim (built once, or taken prebuilt from --shim / FLIXLINT_SHIM) ----
# WhyNot: the built shim does not go under $build_dir by default. It only depends on shim/*.scala and the compiler
# jar, not on the project being linted, so one copy next to the sources serves every project on the machine.
if [ -n "$shim" ]; then
    [ -f "$shim" ] || die "shim jar not found: $shim"
else
    shim="$here/build/flixlint-shim.jar"
    if [ ! -f "$shim" ] || [ -n "$(find "$here/shim" -newer "$shim" -name '*.scala')" ]; then
        # WhyNot: devbox を必ず挟まない。flixlint を release の tarball で置いた所には devbox.json ごと在るとは
        # 限らず、PATH に scala-cli が在れば devbox は要らない。
        if [ -f "$here/devbox.json" ] && command -v devbox >/dev/null 2>&1; then
            scala_cli=(devbox run -- scala-cli)
        elif command -v scala-cli >/dev/null 2>&1; then
            scala_cli=(scala-cli)
        else
            echo "flixlint: the shim is not built and scala-cli was not found." >&2
            echo "          install scala-cli (flixlint's devbox.json has it), or pass a prebuilt jar with" >&2
            echo "          --shim JAR / FLIXLINT_SHIM=JAR (the release has flixlint-shim-<flix version>.jar)." >&2
            exit 4
        fi
        mkdir -p "$here/build"
        echo "flixlint: building the shim" >&2
        (cd "$here" && "${scala_cli[@]}" --power package shim --jar "$flix_jar" --library -o "$shim" -f >/dev/null) \
            || die "the shim did not build (scala-cli package shim)"
    fi
fi
engine="$build_dir/engine"
rm -rf "$engine/src"; mkdir -p "$engine/src/Flixlint"
# shellcheck disable=SC2086
set +e
java $java_opts -cp "$flix_jar:$shim" flixlint.Facts --out "$facts_out" --names-out "$engine/src/Flixlint/Names.flix" --stage "$stage" "${root_opt[@]}" "${pkgs[@]}" "${jars[@]}" "${srcs[@]}"
status=$?
set -e
if [ "$status" -ne 0 ]; then
    # WhyNot: the compiler's Resolution Error does not say that a dependency is missing, and sources that
    # `flix check` accepts fail here when the packages are not passed, so exit 3 with no --pkg says it.
    if [ "$status" -eq 3 ] && [ ${#pkgs[@]} -eq 0 ]; then
        echo "flixlint: the sources do not compile. If they depend on packages that flixlint did not find, name the" >&2
        echo "          project with --project-root DIR, or pass them with --pkg lib/github/.../x.fpkg --jar" >&2
        echo "          lib/cache/.../y.jar (the compiler unpacks them into lib/ once 'flix check' has run)." >&2
    fi
    exit "$status"
fi

# ---- 2. the engine: library + Names.flix + rules.flix + main ----
cp "$here"/src/Flixlint/*.flix "$engine/src/Flixlint/"
cp "$here"/src/Flixlint.flix "$engine/src/"
cp "$rules" "$engine/src/Rules.flix"
printf 'def main(): Unit \\ IO = Flixlint.Engine.lint(%s.rules())\n' "$rules_mod" > "$engine/src/Main.flix"

# WhyNot: the compiler jar is not left out of the key. It is what builds engine.jar, so another FLIX_JAR with the
# same rule sources would reuse the jar the first compiler built. Path, size and mtime identify it without hashing a
# hundred megabytes on every run (`stat` takes the BSD then the GNU spelling, and an mtime it cannot read only makes
# the key coarser). LC_ALL=C fixes the order the globs expand in, which is the collation order and so the locale's.
jar_mtime="$(stat -f %m -- "$flix_jar" 2>/dev/null || stat -c %Y -- "$flix_jar" 2>/dev/null || echo unknown)"
jar_id="$flix_jar $(wc -c < "$flix_jar") $jar_mtime"
hash="$(export LC_ALL=C; { echo "$jar_id"; cat "$engine"/src/*.flix "$engine"/src/Flixlint/*.flix; } | shasum | cut -c1-16)"
engine_jar="$engine/artifact/engine.jar"
if [ ! -f "$engine_jar" ] || [ "$(cat "$engine/built-hash" 2>/dev/null)" != "$hash" ]; then
    printf '[package]\nname = "flixlint-rules"\ndescription = "generated"\nversion = "0.0.0"\nflix = "0.0.0"\nauthors = []\n' > "$engine/flix.toml"
    rm -f "$engine/built-hash"
    # shellcheck disable=SC2086
    if ! (cd "$engine" && java $java_opts -jar "$flix_jar" build-jar --no-install >build.log 2>&1); then
        echo "flixlint: the rules do not compile ($rules; the names come from $engine/src/Flixlint/Names.flix):" >&2
        # The engine compiles the rule file as src/Rules.flix, so the compiler's paths are rewritten back to --rules.
        tr '\r' '\n' < "$engine/build.log" | grep -a -vE '^[[:space:]]*$|^[[:space:]]*\[|^(Found|Resolving|Downloading|  Running|Dependency resolution)' | sed "s@src/Rules\.flix@$rules@g" | tail -60 >&2
        exit 2
    fi
    echo "$hash" > "$engine/built-hash"
fi
# shellcheck disable=SC2086
FLIXLINT_FACTS="$facts_out" FLIXLINT_TODAY="$today" java $java_opts -jar "$engine_jar"
