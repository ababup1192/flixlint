#!/usr/bin/env bash
# flixlint: architecture rules for Flix, checked on the compiler's AST.
#
#   flixlint [--flix-jar JAR] --rules PATH/rules.flix [--pkg FPKG]... [--jar JAR]... [--stage typed|resolved]
#            [--today YYYY-MM-DD] [--limits FILE.json [--limits-base FILE.json]] [--facts-out DIR] [--build-dir DIR] [--project-root DIR] [--shim JAR]
#            [--java-opts "..."] [--spans FILE] [--resident] SRC...
#   flixlint --resident-stop [--build-dir DIR] [--flix-jar JAR] [--shim JAR]
#   flixlint [--flix-jar JAR] --spans FILE [--stage typed|resolved] [--pkg FPKG]... [--jar JAR]... [--project-root DIR] SRC...
#   flixlint --version
#
# --spans FILE also writes the position of every name (README "Spans"); without --rules only that index is written.
#
# Exit codes: 0 no violation, 1 violations (or a ratchet off its limit), 2 the rules are wrong (rules.flix does not compile, an allow that matches
#             nothing, an allowInFile of a file that is not among the sources, a limit for no rule), 3 the sources do not compile,
#             4 the call or the environment is wrong (a missing option, no flix.jar, no scala-cli, a missing package).
#
# Steps: 1) the shim (Scala, on the compiler jar) walks the AST and writes the facts as TSV plus Names.flix
#        2) the rule engine (Flix: the Flixlint library + Names.flix + rules.flix + a generated main) is built into a
#           jar, once per distinct set of those sources, and run against the facts: in the shim's JVM when the jar
#           is already built (flixlint.Lint), in a JVM of its own right after a rebuild.
#
# Environment: FLIX_JAR (the compiler), FLIXLINT_SHIM (a prebuilt shim jar), FLIXLINT_JAVA_OPTS,
#              FLIXLINT_RESIDENT=1 (as --resident), FLIXLINT_RESIDENT_IDLE (minutes before an idle resident server stops; 30).
#
# --resident keeps one JVM per project and build directory (shim/Resident.scala) with the compiler and the rule engine
# loaded: after the first run only the files that changed are compiled again. A run without --resident uses that server
# when one is up, and runs on its own when none is. --resident-stop stops it.
#
# WhyNot: the rule engine is not run through `flix run` on loose files every time. Compiling it costs seconds, so the
# jar is keyed by the hash of its sources and rebuilt only when the rules or the names change.
set -eu

# WhyNot: `dirname "$0"` だけで済ませない。flixlint は submodule や release の展開先から PATH の symlink で
# 呼ばれる事があり、その時 $0 の親は symlink の置き場になって rules/ も shim/ も見つからない。
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
here="$(cd "$(dirname "$self")/.." && pwd)"

version="$(sed -n 's/^version *= *"\(.*\)"/\1/p' "$here/flix.toml")"

flix_jar="${FLIX_JAR:-}"
rules=""
project_root=""
pkgs=()
jars=()
stage="typed"
today=""
limits=""
limits_base=""
facts_out=""
spans=""
build_dir="build/flixlint"
shim="${FLIXLINT_SHIM:-}"
java_opts="${FLIXLINT_JAVA_OPTS:--Xss32m -XX:MaxRAMPercentage=35}"
resident="${FLIXLINT_RESIDENT:-0}"
resident_stop=0
srcs=()

# WhyNot: 使い方の断りに 1 も 2 も使わない。1 は「違反が在る」、2 は「規則が間違っている」で、CI からは
# どちらも lint が仕事をした結果に見える。呼び方と環境の誤りは 4 で分ける。
usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }
die() { echo "flixlint: $1" >&2; exit 4; }

while [ $# -gt 0 ]; do
    case "$1" in
        --flix-jar) flix_jar="$2"; shift 2 ;;
        --rules) rules="$2"; shift 2 ;;
        --pkg) pkgs+=(--pkg "$2"); shift 2 ;;
        --jar) jars+=(--jar "$2"); shift 2 ;;
        --stage) stage="$2"; shift 2 ;;
        --today) today="$2"; shift 2 ;;
        --limits) limits="$2"; shift 2 ;;
        --limits-base) limits_base="$2"; shift 2 ;;
        --facts-out) facts_out="$2"; shift 2 ;;
        --spans) spans="$2"; shift 2 ;;
        --build-dir) build_dir="$2"; shift 2 ;;
        --shim) shim="$2"; shift 2 ;;
        --java-opts) java_opts="$2"; shift 2 ;;
        --project-root) project_root="$2"; shift 2 ;;
        --resident) resident=1; shift ;;
        --resident-stop) resident_stop=1; shift ;;
        --version) echo "flixlint $version"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        --*) echo "flixlint: unknown option $1" >&2; usage >&2; exit 4 ;;
        *) srcs+=("$1"); shift ;;
    esac
done
# 何も指さなかった時だけ bin/flix-jar の解決に落ちる（FLIX_JAR か --flix-jar が在ればそちらが勝つ）。
if [ -z "$flix_jar" ] && [ -x "$here/bin/flix-jar" ]; then flix_jar="$("$here/bin/flix-jar" || true)"; fi
[ -n "$flix_jar" ] && [ -f "$flix_jar" ] || die "--flix-jar JAR (or FLIX_JAR) must point at flix.jar"
[ "$resident_stop" = 1 ] || [ -n "$rules" ] || [ -n "$spans" ] || die "--rules PATH/rules.flix is required (or --spans FILE for the index alone)"
[ -z "$rules" ] || [ -f "$rules" ] || die "rules file not found: $rules"
[ "$resident_stop" = 1 ] || [ ${#srcs[@]} -gt 0 ] || die "at least one source directory is required"
case "$stage" in typed|resolved) ;; *) die "unknown --stage $stage (typed or resolved)" ;; esac
[ -n "$today" ] || today="$(date +%Y-%m-%d)"
if [ -n "$limits" ] && [ ! -f "$limits" ]; then die "limits file not found: $limits"; fi
if [ -n "$limits_base" ] && [ -z "$limits" ]; then die "--limits-base needs --limits"; fi
if [ -n "$limits_base" ] && [ ! -f "$limits_base" ]; then die "limits base file not found: $limits_base"; fi
[ -n "$facts_out" ] || facts_out="$build_dir/facts"
mkdir -p "$build_dir"

# ---- the dependencies, when the caller passed none ----
# WhyNot: flix.toml is not read here. It is TOML, the short and the table form of a dependency both have to be
# understood, and the closure over the installed packages' own manifests with it; the compiler jar the shim already
# runs on carries ManifestParser, so the shim reads it there, typed.
root_opt=()
[ -n "$project_root" ] && root_opt=(--project-root "$project_root")

# The module of rules.flix that holds `pub def rules(): Flixlint.RuleSet`: its first `mod` declaration.
if [ -n "$rules" ]; then
    rules_mod="$(grep -m1 -oE '^[[:space:]]*(pub[[:space:]]+)?mod[[:space:]]+[A-Za-z0-9_.]+' "$rules" | awk '{print $NF}')"
    [ -n "$rules_mod" ] || die "$rules must declare a module (mod MyRules { pub def rules(): Flixlint.RuleSet = ... })"
fi

# ---- 1. the shim (built once, or taken prebuilt from --shim / FLIXLINT_SHIM) ----
# WhyNot: the built shim does not go under $build_dir by default. It only depends on shim/*.scala and the compiler
# jar, not on the project being linted, so one copy next to the sources serves every project on the machine.
if [ -n "$shim" ]; then
    [ -f "$shim" ] || die "shim jar not found: $shim"
else
    shim="$here/build/flixlint-shim.jar"
    if [ ! -f "$shim" ] || [ -n "$(find "$here/shim" -newer "$shim" -name '*.scala')" ]; then
        # WhyNot: devbox を必ず挟まない。flixlint を release の tarball で置いた所には devbox.json ごと在るとは
        # 限らず、PATH に scala-cli が在れば devbox は要らない。
        if [ -f "$here/devbox.json" ] && command -v devbox >/dev/null 2>&1; then
            scala_cli=(devbox run -- scala-cli)
        elif command -v scala-cli >/dev/null 2>&1; then
            scala_cli=(scala-cli)
        else
            echo "flixlint: the shim is not built and scala-cli was not found." >&2
            echo "          install scala-cli (flixlint's devbox.json has it), or pass a prebuilt jar with" >&2
            echo "          --shim JAR / FLIXLINT_SHIM=JAR (the release has flixlint-shim-<flix version>.jar)." >&2
            exit 4
        fi
        mkdir -p "$here/build"
        echo "flixlint: building the shim" >&2
        (cd "$here" && "${scala_cli[@]}" --power package shim --jar "$flix_jar" --library -o "$shim" -f >/dev/null) \
            || die "the shim did not build (scala-cli package shim)"
    fi
fi

# ---- the resident server (--resident, shim/Resident.scala) ----
# The compiler jar by path, size and mtime (the key of engine.jar below and the identity of the resident server).
# WhyNot: not the BSD spelling first. GNU `stat -f` means "the file system's status" and prints the free blocks, which
# change from run to run, so on a Mac with coreutils on PATH the key never matched and the engine was rebuilt every
# run; BSD `stat -c` is an illegal option that prints nothing, so the GNU spelling is tried first.
mtime_of() { stat -c %Y -- "$1" 2>/dev/null || stat -f %m -- "$1" 2>/dev/null || echo unknown; }
jar_id="$flix_jar $(wc -c < "$flix_jar") $(mtime_of "$flix_jar")"
# One server per working directory and build directory, for that compiler and that shim: the facts' paths are relative
# to the directory the server started in, and a server with other jars stops when it is called (exit 11 below).
# WhyNot: the socket is not put under $build_dir. A Unix socket's path is capped near 100 bytes and a build directory
# can be deep, so it goes to /tmp under a hash.
mkdir -p "$build_dir"
build_abs="$(cd "$build_dir" && pwd)"
identity="$jar_id|$shim $(wc -c < "$shim") $(mtime_of "$shim")|$PWD"
socket="/tmp/flixlint-$(id -u)-$(printf '%s' "$PWD|$build_abs" | shasum | cut -c1-16).sock"
# The client is a JVM that only relays bytes, so it skips the optimizing compiler and the parallel collector.
resident_client() {
    java -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -cp "$flix_jar:$shim" flixlint.Resident client --socket "$socket" --identity "$@"
}
if [ "$resident_stop" = 1 ]; then
    # A call with another identity stops the server (the identity "stop" is no server's).
    if [ -S "$socket" ]; then resident_client stop >/dev/null 2>&1 || true; fi
    exit 0
fi
engine="$build_dir/engine"
rm -rf "$engine/src"; mkdir -p "$engine/src/Flixlint"
spans_opt=()
[ -n "$spans" ] && spans_opt=(--spans "$spans")
facts_args=(--out "$facts_out" --names-out "$engine/src/Flixlint/Names.flix" --stage "$stage" "${spans_opt[@]}" "${root_opt[@]}" "${pkgs[@]}" "${jars[@]}" "${srcs[@]}")

# Says why the facts could not be written, and leaves with the shim's exit code.
facts_failed() {
    # WhyNot: the compiler's Resolution Error does not say that a dependency is missing, and sources that
    # `flix check` accepts fail here when the packages are not passed, so exit 3 with no --pkg says it.
    if [ "$1" -eq 3 ] && [ ${#pkgs[@]} -eq 0 ]; then
        echo "flixlint: the sources do not compile. If they depend on packages that flixlint did not find, name the" >&2
        echo "          project with --project-root DIR, or pass them with --pkg lib/github/.../x.fpkg --jar" >&2
        echo "          lib/cache/.../y.jar (the compiler unpacks them into lib/ once 'flix check' has run)." >&2
    fi
    exit "$1"
}

# --spans without --rules: the index is what was asked for, and the rule engine has nothing to run.
if [ -z "$rules" ]; then
    set +e
    # shellcheck disable=SC2086
    java $java_opts -cp "$flix_jar:$shim" flixlint.Facts "${facts_args[@]}"
    status=$?
    set -e
    [ "$status" -eq 0 ] || facts_failed "$status"
    exit 0
fi

# ---- 2. the engine: library + Names.flix (written by the shim) + rules.flix + main ----
cp "$here"/src/Flixlint/*.flix "$engine/src/Flixlint/"
cp "$here"/src/Flixlint.flix "$engine/src/"
cp "$rules" "$engine/src/Rules.flix"
printf 'def main(): Unit \\ IO = Flixlint.Engine.lint(%s.rules())\n' "$rules_mod" > "$engine/src/Main.flix"

# The key of engine.jar: the compiler and every engine source but Names.flix, which the shim adds to it once written.
# WhyNot: the compiler jar is not left out of the key. It is what builds engine.jar, so another FLIX_JAR with the
# same rule sources would reuse the jar the first compiler built. Path, size and mtime identify it without hashing a
# hundred megabytes on every run (an mtime it cannot read only makes the key coarser). LC_ALL=C fixes the order the
# globs expand in, which is the collation order and so the locale's.
key="$(export LC_ALL=C; { echo "$jar_id"; cat "$engine"/src/*.flix "$engine"/src/Flixlint/*.flix; } | shasum | cut -c1-40)"
engine_jar="$engine/artifact/engine.jar"
export FLIXLINT_FACTS="$facts_out" FLIXLINT_TODAY="$today" FLIXLINT_LIMITS="$limits" FLIXLINT_LIMITS_BASE="$limits_base"

# The facts, then the engine in the same JVM when engine.jar was built for these sources (flixlint.Lint).
# WhyNot: not one JVM for the facts and another for the engine. Each start costs the JVM and the class loading of
# the Flix runtime, on every run; only a rebuild of the engine (exit 10) still takes a JVM of its own.
rm -f "$engine/wanted-hash"
lint_args=(--engine "$engine" --engine-key "$key" "${facts_args[@]}")
# The resident server when one is up (or --resident starts it), else a JVM of its own. Exit 11: no server served the run.
status=11
set +e
if [ -S "$socket" ]; then resident_client "$identity" "${lint_args[@]}"; status=$?; fi
if [ "$status" -eq 11 ] && [ "$resident" = 1 ]; then
    echo "flixlint: starting the resident server (log: $build_dir/resident.log)" >&2
    # shellcheck disable=SC2086
    java $java_opts -cp "$flix_jar:$shim" flixlint.Resident server --socket "$socket" --identity "$identity" \
        --idle-minutes "${FLIXLINT_RESIDENT_IDLE:-30}" </dev/null >>"$build_dir/resident.log" 2>&1 &
    resident_client "$identity" --wait 60 "${lint_args[@]}"
    status=$?
fi
if [ "$status" -eq 11 ]; then
    # shellcheck disable=SC2086
    java $java_opts -cp "$flix_jar:$shim" flixlint.Lint "${lint_args[@]}"
    status=$?
fi
set -e
case "$status" in
    10) ;;
    3|4) facts_failed "$status" ;;
    *) exit "$status" ;;
esac

printf '[package]\nversion = "0.0.0"\nflix = "0.0.0"\n' > "$engine/flix.toml"
rm -f "$engine/built-hash"
# shellcheck disable=SC2086
if ! (cd "$engine" && java $java_opts -jar "$flix_jar" build-jar --no-install >build.log 2>&1); then
    echo "flixlint: the rules do not compile ($rules; the names come from $engine/src/Flixlint/Names.flix):" >&2
    # The engine compiles the rule file as src/Rules.flix, so the compiler's paths are rewritten back to --rules.
    # WhyNot: not the last 60 lines. Flix reports the errors in order and the later ones usually follow from the
    # first, so the end of the log is the derived noise and the head is the one error worth reading.
    tr '\r' '\n' < "$engine/build.log" | grep -a -vE '^[[:space:]]*$|^[[:space:]]*\[|^(Found|Resolving|Downloading|  Running|Dependency resolution)' | sed "s@src/Rules\.flix@$rules@g" | head -60 >&2
    echo "flixlint: the whole compiler output is in $engine/build.log" >&2
    exit 2
fi
cp "$engine/wanted-hash" "$engine/built-hash"
# shellcheck disable=SC2086
java $java_opts -jar "$engine_jar"
